<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.druvu</groupId>
	<artifactId>druvu-lib-json</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>druvu-lib-json</name>
	<description>A fluent JSON builder with pluggable serialization backends</description>

	<developers>
		<developer>
			<name>Deniss Larka</name>
		</developer>
		<developer>
			<name>Bryn Cooke</name>
			<roles>
				<role>author of the original fluent-json</role>
			</roles>
		</developer>
	</developers>

	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
		</license>
	</licenses>

	<modules>
		<module>druvu-lib-json-api</module>
		<module>druvu-lib-json-gson</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>25</java.version>

		<!-- Dependency versions -->
		<druvu-lib-loader.version>1.1.1</druvu-lib-loader.version>
		<gson.version>2.14.0</gson.version>
		<testng.version>7.12.0</testng.version>
		<assertj.version>3.27.7</assertj.version>

		<!-- Plugin versions -->
		<maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
		<maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
		<maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>

		<!-- Code quality plugin versions (same set as druvu-lib-jdbc / druvu-acc-parent) -->
		<spotbugs-maven-plugin.version>4.10.4.1</spotbugs-maven-plugin.version>
		<maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<spotless-maven-plugin.version>3.10.2</spotless-maven-plugin.version>
		<palantir-java-format.version>2.90.0</palantir-java-format.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.druvu</groupId>
				<artifactId>druvu-lib-json-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.druvu</groupId>
				<artifactId>druvu-lib-loader</artifactId>
				<version>${druvu-lib-loader.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.code.gson</groupId>
				<artifactId>gson</artifactId>
				<version>${gson.version}</version>
			</dependency>
			<!-- TEST -->
			<dependency>
				<groupId>org.testng</groupId>
				<artifactId>testng</artifactId>
				<version>${testng.version}</version>
				<scope>test</scope>
			</dependency>
			<dependency>
				<groupId>org.assertj</groupId>
				<artifactId>assertj-core</artifactId>
				<version>${assertj.version}</version>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin.version}</version>
					<configuration>
						<release>${java.version}</release>
						<debug>true</debug>
						<showDeprecation>true</showDeprecation>
						<showWarnings>true</showWarnings>
						<compilerArgs>
							<arg>-parameters</arg>
						</compilerArgs>
					</configuration>
				</plugin>
				<plugin>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>${maven-surefire-plugin.version}</version>
					<configuration>
						<!-- Tests run on the classpath; this exercises the META-INF/services
						     discovery path and avoids patching the module graph for TestNG. -->
						<useModulePath>false</useModulePath>
					</configuration>
				</plugin>

				<!-- Code quality plugins. Configured here, activated in <build><plugins> below - they are
				     part of `verify`, not optional. Checkstyle declares no execution, so it stays a
				     report-only goal (`mvn checkstyle:check`), same as in druvu-lib-jdbc. -->

				<plugin>
					<groupId>com.github.spotbugs</groupId>
					<artifactId>spotbugs-maven-plugin</artifactId>
					<version>${spotbugs-maven-plugin.version}</version>
					<configuration>
						<effort>Max</effort>
						<threshold>Low</threshold>
						<xmlOutput>true</xmlOutput>
						<includeTests>true</includeTests>
						<excludeFilterFile>${maven.multiModuleProjectDirectory}/_spotbug-filters/spotbugs-exclude.xml</excludeFilterFile>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<artifactId>maven-pmd-plugin</artifactId>
					<version>${maven-pmd-plugin.version}</version>
					<configuration>
						<printFailingErrors>true</printFailingErrors>
						<failurePriority>3</failurePriority>
						<includeTests>true</includeTests>
						<linkXRef>false</linkXRef>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>check</goal>
								<goal>cpd-check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>${maven-checkstyle-plugin.version}</version>
					<configuration>
						<configLocation>google_checks.xml</configLocation>
					</configuration>
				</plugin>

				<plugin>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>${maven-enforcer-plugin.version}</version>
					<executions>
						<execution>
							<id>enforce</id>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<rules>
									<banDuplicatePomDependencyVersions/>
									<reactorModuleConvergence/>
									<dependencyConvergence/>
									<requireJavaVersion>
										<version>${java.version}</version>
									</requireJavaVersion>
								</rules>
							</configuration>
						</execution>
					</executions>
				</plugin>

			</plugins>
		</pluginManagement>

		<plugins>
			<!-- Code quality gates: configured in pluginManagement above, listed here so they
			     actually run as part of `verify`. -->
			<plugin>
				<groupId>com.github.spotbugs</groupId>
				<artifactId>spotbugs-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-pmd-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-enforcer-plugin</artifactId>
			</plugin>

			<!-- spotless: house code formatter (same config as druvu-lib-jdbc / druvu-lib-loader /
			     druvu-acc-parent). `mvn spotless:apply` reformats; `check` runs in verify and fails
			     on unformatted code. -->
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless-maven-plugin.version}</version>
				<configuration>
					<java>
						<palantirJavaFormat>
							<version>${palantir-java-format.version}</version>
							<style>PALANTIR</style>
							<formatJavadoc>true</formatJavadoc>
						</palantirJavaFormat>
						<removeUnusedImports/>
					</java>
				</configuration>
				<executions>
					<execution>
						<goals>
							<goal>check</goal>
						</goals>
						<phase>verify</phase>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
